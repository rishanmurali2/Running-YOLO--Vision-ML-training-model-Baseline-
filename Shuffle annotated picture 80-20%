import os
import glob
import random
import shutil

# --- Define Your Absolute Paths ---
source_dir = r"C:\Users\risha\OneDrive\Desktop\ML FFB trial\raw_dataset\obj_train_data"
target_base = r"C:\Users\risha\OneDrive\Desktop\ML FFB trial\FFB Dataset"

# Target subdirectories for YOLO structure
train_img_dir = os.path.join(target_base, "train", "images")
train_lbl_dir = os.path.join(target_base, "train", "labels")
val_img_dir = os.path.join(target_base, "val", "images")
val_lbl_dir = os.path.join(target_base, "val", "labels")

# --- Step 1: Safe File-Level Clean Target Folders & Clear Cache ---
print("Cleaning out old files inside dataset folders...")
for folder in [train_img_dir, train_lbl_dir, val_img_dir, val_lbl_dir]:
    os.makedirs(folder, exist_ok=True)
    # Delete individual files inside instead of deleting the whole folder
    for file_path in glob.glob(os.path.join(folder, "*")):
        try:
            if os.path.isfile(file_path):
                os.remove(file_path)
        except Exception as e:
            print(f"Skipped locked file: {file_path} due to {e}")

# Clear old YOLO cache files if they exist in the parent directories
for cache_file in glob.glob(os.path.join(target_base, "**", "*.cache"), recursive=True):
    try:
        os.remove(cache_file)
        print(f"Removed old cache: {os.path.basename(cache_file)}")
    except OSError:
        pass

# --- Step 2: Gather and Match All Image Files ---
image_extensions = ('*.png', '*.jpg', '*.jpeg', '*.PNG', '*.JPG', '*.JPEG')
all_images = []
for ext in image_extensions:
    all_images.extend(glob.glob(os.path.join(source_dir, ext)))

print(f"Found {len(all_images)} total images in raw source directory.")

# --- Step 3: Shuffle and Calculate 80/20 Split ---
random.seed(42)  # Hardcoded seed for reproducible results
random.shuffle(all_images)

split_index = int(0.8 * len(all_images))
train_images = all_images[:split_index]
val_images = all_images[split_index:]

print(f"Splitting strategy: {len(train_images)} images to Train | {len(val_images)} images to Val.")

# --- Step 4: Move Files Helper Function ---
def distribute_files(image_list, dest_img_dir, dest_lbl_dir):
    copied_count = 0
    for img_path in image_list:
        base_name = os.path.splitext(os.path.basename(img_path))[0]
        lbl_path = os.path.join(source_dir, f"{base_name}.txt")
        
        if os.path.exists(lbl_path):
            shutil.copy2(img_path, os.path.join(dest_img_dir, os.path.basename(img_path)))
            shutil.copy2(lbl_path, os.path.join(dest_lbl_dir, f"{base_name}.txt"))
            copied_count += 1
    return copied_count

# --- Step 5: Execute File Distribution ---
print("\nDistributing files...")
train_copied = distribute_files(train_images, train_img_dir, train_lbl_dir)
val_copied = distribute_files(val_images, val_img_dir, val_lbl_dir)

print("--- Distribution Complete! ---")
print(f"Successfully arranged {train_copied} image/label pairs into Train.")
print(f"Successfully arranged {val_copied} image/label pairs into Validation.")
